@{
    ViewData["Title"] = "التحقق من شهادة";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-body p-5 text-center">
                <i class="bi bi-shield-check text-primary" style="font-size:4rem"></i>
                <h3 class="mt-3 mb-4">التحقق من صحة شهادة</h3>
                <p class="text-muted">أدخل رقم الشهادة أو رمز التحقق للتحقق من صحتها</p>
                <form asp-action="Verify" method="post">
                    @Html.AntiForgeryToken()
                    <div class="input-group mb-3">
                        <input type="text" name="code" class="form-control form-control-lg text-center" placeholder="CERT-2024-XXXX أو رمز التحقق" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-search"></i> تحقق</button>
                </form>
            </div>
        </div>
    </div>
</div>
