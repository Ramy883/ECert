@model ECert.Models.CertificatePrintViewModel
@{
    Layout = null;
    var certificate = Model.Certificate;
    var template = Model.Template;
    var elements = template.ElementOrder.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@template.CertificateTitle - @certificate.CertificateNumber</title>
    <style>
        :root { --primary: @template.PrimaryColor; --accent: @template.AccentColor; --ink: @template.TextColor; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #eef2f7; color: var(--ink); font-family: Tahoma, Arial, sans-serif; }
        .toolbar { max-width: 1120px; margin: 20px auto 0; display: flex; gap: 8px; justify-content: flex-start; }
        .toolbar button, .toolbar a { border: 0; border-radius: 8px; padding: 10px 16px; text-decoration: none; cursor: pointer; font-size: 14px; }
        .toolbar button { background: var(--primary); color: #fff; }
        .toolbar a { background: #fff; color: var(--primary); }
        .certificate-sheet { width: min(1120px, calc(100vw - 32px)); min-height: 790px; margin: 16px auto 32px; padding: 46px 62px; background: #fff; border: 14px solid var(--primary); outline: 3px solid var(--accent); outline-offset: -25px; box-shadow: 0 18px 55px rgba(15, 23, 42, .18); display: flex; flex-direction: column; position: relative; text-align: center; }
        .certificate-sheet::before, .certificate-sheet::after { content: ""; position: absolute; width: 90px; height: 90px; border: 2px solid var(--accent); opacity: .6; }
        .certificate-sheet::before { top: 25px; right: 25px; border-left: 0; border-bottom: 0; }
        .certificate-sheet::after { bottom: 25px; left: 25px; border-right: 0; border-top: 0; }
        .element { margin-bottom: 18px; }
        .logo img { max-width: 180px; max-height: 90px; object-fit: contain; }
        .center-name { color: var(--primary); font-size: 20px; font-weight: 700; letter-spacing: .4px; }
        .title { color: var(--primary); font-size: 38px; font-weight: 800; margin: 4px 0; }
        .body-text { max-width: 780px; margin: 0 auto; font-size: 17px; line-height: 1.9; }
        .trainee { border-top: 2px solid var(--accent); border-bottom: 2px solid var(--accent); padding: 16px 10px; margin: 16px auto; max-width: 820px; }
        .trainee-ar { font-size: 30px; font-weight: 800; color: var(--primary); }
        .trainee-en { font-size: 21px; font-weight: 600; direction: ltr; margin-top: 4px; }
        .course { font-size: 22px; font-weight: 700; }
        .course-en { direction: ltr; color: var(--primary); }
        .course-ar { color: var(--primary); margin-top: 5px; }
        .date { font-size: 15px; color: #4b5563; }
        .additional { font-size: 15px; line-height: 1.7; }
        .verification { margin-top: auto; padding-top: 15px; border-top: 1px solid #d1d5db; font-size: 12px; line-height: 1.7; }
        .verification-code { display: inline-block; margin: 4px 0; padding: 3px 10px; border: 1px solid var(--accent); border-radius: 5px; font-family: Consolas, monospace; direction: ltr; }
        .signatures { display: flex; justify-content: space-around; align-items: flex-end; gap: 40px; margin-top: 18px; min-height: 85px; }
        .signature { min-width: 180px; font-size: 13px; color: #4b5563; }
        .signature img { max-width: 170px; max-height: 60px; object-fit: contain; display: block; margin: 0 auto 6px; }
        .legacy-note { max-width: 1120px; margin: 8px auto; color: #6b7280; font-size: 12px; text-align: center; }
        @@media print {
            body { background: #fff; }
            .toolbar, .legacy-note { display: none !important; }
            .certificate-sheet { width: 100%; min-height: 190mm; margin: 0; box-shadow: none; page-break-after: avoid; }
            @@page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">طباعة الشهادة</button>
        <a href="@Url.Action("Index", "Certificates")">العودة إلى الشهادات</a>
    </div>
    @if (Model.IsLegacyTemplate)
    {
        <p class="legacy-note">هذه شهادة قديمة، وتستخدم القالب الافتراضي المحفوظ للحفاظ على ثبات شكلها.</p>
    }
    <main class="certificate-sheet">
        @foreach (var element in elements)
        {
            switch (element.ToLowerInvariant())
            {
                case "logo" when !string.IsNullOrWhiteSpace(template.LogoPath):
                    <div class="element logo"><img src="@template.LogoPath" alt="شعار المركز" /></div>
                    break;
                case "title":
                    <div class="element"><div class="center-name">@template.CenterName</div><div class="title">@template.CertificateTitle</div></div>
                    break;
                case "body":
                    <div class="element body-text">@template.MainText</div>
                    break;
                case "trainee":
                    <div class="element trainee"><div class="trainee-ar">@(certificate.TraineeNameArabic ?? certificate.TraineeName)</div><div class="trainee-en">@(certificate.TraineeNameEnglish ?? certificate.TraineeName)</div></div>
                    break;
                case "course":
                    <div class="element course"><div class="course-en">@certificate.CourseNameEnglish</div><div class="course-ar">@certificate.CourseNameArabic</div></div>
                    break;
                case "date" when template.ShowIssueDate:
                    <div class="element date">تاريخ الإصدار: @certificate.IssueDate.ToString("yyyy-MM-dd")</div>
                    break;
                case "additional" when !string.IsNullOrWhiteSpace(template.AdditionalText):
                    <div class="element additional">@template.AdditionalText</div>
                    break;
                case "verification" when template.ShowVerificationCode || template.ShowCertificateNumber || template.ShowVerificationUrl:
                    <div class="element verification">
                        @if (template.ShowCertificateNumber) { <span>رقم الشهادة: <b>@certificate.CertificateNumber</b></span><br /> }
                        @if (template.ShowVerificationCode) { <span>@template.VerificationLabel: <span class="verification-code">@certificate.VerificationCode</span></span><br /> }
                        @if (template.ShowVerificationUrl) { <span dir="ltr">@Model.VerificationUrl</span> }
                    </div>
                    break;
                case "signatures":
                    <div class="element signatures">
                        <div class="signature">@if (!string.IsNullOrWhiteSpace(template.RightSignaturePath)) { <img src="@template.RightSignaturePath" alt="التوقيع الأيمن" /> }<span>اعتماد الجهة</span></div>
                        <div class="signature">@if (!string.IsNullOrWhiteSpace(template.LeftSignaturePath)) { <img src="@template.LeftSignaturePath" alt="التوقيع الأيسر" /> }<span>المسؤول المختص</span></div>
                    </div>
                    break;
            }
        }
    </main>
</body>
</html>
