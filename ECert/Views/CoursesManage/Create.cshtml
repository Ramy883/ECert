@model Course
@{
    ViewData["Title"] = "إضافة دورة جديدة";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<Category> ?? new();
    var instructors = ViewBag.Instructors as List<Instructor> ?? new();
    var certificateDesigns = ViewBag.CertificateDesigns as List<CertificateDesign> ?? new();
    var selectedInstructorIds = Model?.SelectedInstructorIds ?? new List<int>();
    var instructorOptionsJson = System.Text.Json.JsonSerializer.Serialize(instructors.Select(i => new { value = i.InstructorId, label = i.FullName }).OrderBy(x => x.label));
    var selectedInstructorIdsJson = System.Text.Json.JsonSerializer.Serialize(selectedInstructorIds);
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><h4 class="mb-0"><i class="bi bi-plus-circle"></i> إضافة دورة جديدة</h4></div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CourseNameEnglish" class="form-label"></label>
                            <input asp-for="CourseNameEnglish" class="form-control" dir="ltr" />
                            <span asp-validation-for="CourseNameEnglish" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CourseNameArabic" class="form-label"></label>
                            <input asp-for="CourseNameArabic" class="form-control" dir="rtl" />
                            <span asp-validation-for="CourseNameArabic" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" type="number" step="0.01" asp-format="{0:0.################}" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountType" class="form-label"></label>
                            <select asp-for="DiscountType" class="form-select" id="discountType">
                                <option value="">بدون خصم</option>
                                <option value="Percentage">نسبة مئوية %</option>
                                <option value="Fixed">مبلغ ثابت</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountValue" class="form-label"></label>
                            <input asp-for="DiscountValue" type="number" step="0.01" asp-format="{0:0.################}" class="form-control" id="discountValue" />
                            <span asp-validation-for="DiscountValue" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ShortDescription" class="form-label"></label>
                            <input asp-for="ShortDescription" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="FullDescription" class="form-label"></label>
                            <textarea asp-for="FullDescription" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Objectives" class="form-label"></label>
                            <textarea asp-for="Objectives" class="form-control" rows="3" placeholder="اكتب كل هدف في سطر"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="3" placeholder="محتوى ومحاور الدورة"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">الفئة</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- اختر الفئة --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">المدربون</label>
                            <div class="search-select">
                                <input type="text" id="instructorSearch" class="form-control" placeholder="اكتب اسم المدرب للبحث ثم اختر من القائمة..." autocomplete="off" role="combobox" aria-expanded="false" aria-controls="instructorResults" />
                                <div id="instructorResults" class="list-group position-absolute w-100 shadow-sm search-results" role="listbox" hidden></div>
                            </div>
                            <div class="form-text">بحث ذكي — اكتب جزءاً من اسم المدرب واختر من القائمة. يمكن إضافة أكثر من مدرب للدورة الواحدة.</div>
                            <div id="instructorHidden"></div>
                            <div id="selectedInstructors" class="d-flex flex-wrap gap-2 mt-2"></div>
                            <span asp-validation-for="SelectedInstructorIds" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CertificateDesignId" class="form-label">قالب شهادة هذه الدورة</label>
                            <select asp-for="CertificateDesignId" class="form-select">
                                <option value="">القالب العام المنشور (افتراضي)</option>
                                @foreach (var design in certificateDesigns)
                                {
                                    <option value="@design.CertificateDesignId">@design.Name@(design.IsPublished ? " — منشور" : " — مسودة")</option>
                                }
                            </select>
                            <div class="form-text">يمكن تخصيص قالب مستقل لهذه الدورة. عند تركه فارغاً سيُستخدم القالب العام المنشور.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="مثال: قاعة 1 - الطابق الثاني" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">مسودة</option>
                                <option value="Published">منشورة</option>
                                <option value="OpenForRegistration">مفتوحة للتسجيل</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsFeatured" class="form-check-input" />
                                <label asp-for="IsFeatured" class="form-check-label">دورة مميزة</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="border rounded-3 p-3 bg-light">
                                <div class="form-check form-switch mb-1">
                                    <input asp-for="RequiresAcademicDetails" class="form-check-input" />
                                    <label asp-for="RequiresAcademicDetails" class="form-check-label fw-semibold">دورة جامعية</label>
                                </div>
                                <small class="text-muted">عند التفعيل، تصبح الجامعة والكلية والتخصص والمستوى الدراسي مطلوبة عند تسجيل المتدرب.</small>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">صورة الدورة</label>
                            <input type="file" name="image" accept="image/*" class="form-control" onchange="previewImage(this, 'imgPreview')" />
                            <img id="imgPreview" class="mt-2 rounded" style="max-height:150px; display:none;" />
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ الدورة</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .search-select { position: relative; }
    .search-results { z-index: 1050; max-height: 220px; overflow-y: auto; }
    .search-results .list-group-item { text-align: right; cursor: pointer; }
    .search-results .list-group-item:hover { background-color: #eef2ff; }
</style>
<script>
const instructorOptions = @Html.Raw(instructorOptionsJson);
const initialSelectedInstructorIds = @Html.Raw(selectedInstructorIdsJson);
(function () {
    const all = instructorOptions;
    const selected = new Set(initialSelectedInstructorIds);
    const searchInput = document.getElementById('instructorSearch');
    const resultsBox = document.getElementById('instructorResults');
    const chipsBox = document.getElementById('selectedInstructors');
    const hiddenBox = document.getElementById('instructorHidden');

    function syncHidden() {
        hiddenBox.replaceChildren();
        selected.forEach(function (id) {
            const h = document.createElement('input');
            h.type = 'hidden';
            h.name = 'SelectedInstructorIds';
            h.value = id;
            hiddenBox.appendChild(h);
        });
    }

    function renderChips() {
        chipsBox.replaceChildren();
        selected.forEach(function (id) {
            const instr = all.find(function (x) { return x.value === id; });
            if (!instr) return;
            const chip = document.createElement('span');
            chip.className = 'badge text-bg-primary d-inline-flex align-items-center gap-2';
            chip.style.fontSize = '0.9rem';
            chip.style.padding = '0.45rem 0.75rem';
            const name = document.createElement('span');
            name.textContent = instr.label;
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'btn-close btn-close-white';
            remove.style.fontSize = '0.55rem';
            remove.setAttribute('aria-label', 'إزالة المدرب');
            remove.addEventListener('click', function () {
                selected.delete(id);
                syncHidden();
                renderChips();
            });
            chip.append(name, remove);
            chipsBox.appendChild(chip);
        });
    }

    function hideResults() {
        resultsBox.hidden = true;
        resultsBox.replaceChildren();
        searchInput.setAttribute('aria-expanded', 'false');
    }

    function runSearch() {
        const q = searchInput.value.trim().toLowerCase();
        const matches = all
            .filter(function (x) { return !selected.has(x.value) && x.label.toLowerCase().indexOf(q) !== -1; })
            .slice(0, 15);
        resultsBox.replaceChildren();
        if (!matches.length) {
            const empty = document.createElement('div');
            empty.className = 'list-group-item text-muted small';
            empty.textContent = q ? 'لا توجد نتائج مطابقة.' : 'لا يوجد مدربون متاحون.';
            resultsBox.append(empty);
        } else {
            matches.forEach(function (instr) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                btn.setAttribute('role', 'option');
                const txt = document.createElement('span');
                txt.textContent = instr.label;
                const icon = document.createElement('i');
                icon.className = 'bi bi-plus-circle text-success';
                btn.append(txt, icon);
                btn.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    if (!selected.has(instr.value)) {
                        selected.add(instr.value);
                        syncHidden();
                        renderChips();
                    }
                    hideResults();
                });
                resultsBox.append(btn);
            });
        }
        resultsBox.hidden = false;
        searchInput.setAttribute('aria-expanded', 'true');
    }

    searchInput.addEventListener('input', runSearch);
    searchInput.addEventListener('focus', function () {
        if (resultsBox.hidden) runSearch();
    });
    searchInput.addEventListener('blur', function () { setTimeout(hideResults, 180); });

    syncHidden();
    renderChips();
})();
</script>
<script>
function previewImage(input, previewId) {
    var preview = document.getElementById(previewId);
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    } else { preview.style.display = 'none'; }
}
</script>
}
