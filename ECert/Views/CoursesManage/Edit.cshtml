@model Course
@{
    ViewData["Title"] = "تعديل دورة";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<Category> ?? new();
    var instructors = ViewBag.Instructors as List<Instructor> ?? new();
    var certificateDesigns = ViewBag.CertificateDesigns as List<CertificateDesign> ?? new();
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><h4 class="mb-0"><i class="bi bi-pencil"></i> تعديل دورة: @Model.CourseNameEnglish / @Model.CourseNameArabic</h4></div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CourseId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CourseNameEnglish" class="form-label"></label>
                            <input asp-for="CourseNameEnglish" class="form-control" dir="ltr" />
                            <span asp-validation-for="CourseNameEnglish" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CourseNameArabic" class="form-label"></label>
                            <input asp-for="CourseNameArabic" class="form-control" dir="rtl" />
                            <span asp-validation-for="CourseNameArabic" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountType" class="form-label"></label>
                            <select asp-for="DiscountType" class="form-select" id="discountType">
                                <option value="">بدون خصم</option>
                                <option value="Percentage">نسبة مئوية %</option>
                                <option value="Fixed">مبلغ ثابت</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiscountValue" class="form-label"></label>
                            <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" id="discountValue" />
                            <span asp-validation-for="DiscountValue" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ShortDescription" class="form-label"></label>
                            <input asp-for="ShortDescription" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="FullDescription" class="form-label"></label>
                            <textarea asp-for="FullDescription" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Objectives" class="form-label"></label>
                            <textarea asp-for="Objectives" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">الفئة</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- اختر الفئة --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="InstructorId" class="form-label">المدرب</label>
                            <select asp-for="InstructorId" class="form-select">
                                <option value="">-- اختر المدرب --</option>
                                @foreach (var inst in instructors)
                                {
                                    <option value="@inst.InstructorId">@inst.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="InstructorId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CertificateDesignId" class="form-label">قالب شهادة هذه الدورة</label>
                            <select asp-for="CertificateDesignId" class="form-select">
                                <option value="">القالب العام المنشور (افتراضي)</option>
                                @foreach (var design in certificateDesigns)
                                {
                                    <option value="@design.CertificateDesignId">@design.Name@(design.IsPublished ? " — منشور" : " — مسودة")</option>
                                }
                            </select>
                            <div class="form-text">يُستخدم هذا القالب عند التحقق من شهادات الدورة. اتركه فارغاً لاستخدام القالب العام المنشور.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">مسودة</option>
                                <option value="Published">منشورة</option>
                                <option value="OpenForRegistration">مفتوحة للتسجيل</option>
                                <option value="InProgress">جارية</option>
                                <option value="Completed">مكتملة</option>
                                <option value="Archived">مؤرشفة</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsFeatured" class="form-check-input" />
                                <label asp-for="IsFeatured" class="form-check-label">دورة مميزة</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="border rounded-3 p-3 bg-light">
                                <div class="form-check form-switch mb-1">
                                    <input asp-for="RequiresAcademicDetails" class="form-check-input" />
                                    <label asp-for="RequiresAcademicDetails" class="form-check-label fw-semibold">دورة جامعية</label>
                                </div>
                                <small class="text-muted">عند التفعيل، يُطلب من المتدرب إدخال الجامعة والكلية والتخصص والمستوى الدراسي أثناء التسجيل.</small>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">صورة الدورة</label>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-2"><img src="@Model.ImageUrl" class="rounded" style="max-height:120px;" /></div>
                            }
                            <input type="file" name="image" accept="image/*" class="form-control" onchange="previewImage(this, 'imgPreview')" />
                            <img id="imgPreview" class="mt-2 rounded" style="max-height:150px; display:none;" />
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ التعديلات</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewImage(input, previewId) {
    var preview = document.getElementById(previewId);
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    } else { preview.style.display = 'none'; }
}
</script>
}
