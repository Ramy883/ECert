@model Invoice
@{
    ViewData["Title"] = "فاتورة " + Model.InvoiceNumber;
    Layout = "_AdminLayout";
}
<h2 class="mb-4"><i class="bi bi-receipt"></i> فاتورة @Model.InvoiceNumber</h2>
<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">بيانات الفاتورة</h6></div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr><th class="w-50">رقم الفاتورة</th><td><code>@Model.InvoiceNumber</code></td></tr>
                    <tr><th>المتدرب</th><td>@Model.TraineeName</td></tr>
                    <tr><th>الهاتف</th><td>@Model.TraineePhone</td></tr>
                    <tr><th>الدورة</th><td>@Model.CourseName</td></tr>
                    <tr><th>المبلغ الإجمالي</th><td class="fw-bold">@Model.TotalAmount ريال</td></tr>
                    <tr><th>المبلغ المدفوع</th><td class="text-success">@Model.PaidAmount ريال</td></tr>
                    <tr><th>المبلغ المتبقي</th><td class="text-danger">@Model.RemainingAmount ريال</td></tr>
                    <tr><th>الحالة</th><td>
                        @switch (Model.Status)
                        {
                            case "Unpaid": <span class="badge bg-danger">غير مدفوعة</span> break;
                            case "PartiallyPaid": <span class="badge bg-warning text-dark">مدفوعة جزئياً</span> break;
                            case "Paid": <span class="badge bg-success">مدفوعة</span> break;
                            case "Cancelled": <span class="badge bg-secondary">ملغية</span> break;
                        }
                    </td></tr>
                    <tr><th>تاريخ الإنشاء</th><td>@Model.CreatedAt.ToString("yyyy-MM-dd")</td></tr>
                    <tr><th>تاريخ الاستحقاق</th><td>@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td></tr>
                    <tr><th>أنشأها</th><td>@Model.CreatedBy</td></tr>
                </table>
                @if (Model.Status != "Paid" && Model.Status != "Cancelled")
                {
                    <a asp-controller="Payments" asp-action="Add" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-success btn-sm"><i class="bi bi-cash"></i> تسجيل دفعة</a>
                    <form asp-action="Cancel" method="post" style="display:inline" onsubmit="return confirm('هل أنت متأكد من إلغاء الفاتورة؟')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.InvoiceId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> إلغاء الفاتورة</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-cash-stack"></i> الدفعات</h6></div>
            <div class="card-body">
                @if (Model.Payments.Any())
                {
                    @foreach (var p in Model.Payments)
                    {
                        <div class="border rounded-3 p-3 mb-3 @(p.IsCancelled ? "border-danger bg-danger bg-opacity-10" : "")">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="fw-bold fs-5 text-primary">@p.Amount ريال</span>
                                @if (p.IsCancelled) { <span class="badge bg-danger">ملغاة</span> }
                                else { <span class="badge bg-success">صحيحة</span> }
                            </div>
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <th class="text-muted" style="width:120px;">طريقة الدفع</th>
                                    <td>
                                        @switch (p.PaymentMethod)
                                        {
                                            case "Cash": <span><i class="bi bi-cash"></i> نقد</span> break;
                                            case "BankTransfer": <span><i class="bi bi-wallet2"></i> محافظ إلكترونية</span> break;
                                            case "EWallet": <span><i class="bi bi-wallet2"></i> محفظة إلكترونية</span> break;
                                            case "Card": <span><i class="bi bi-wallet2"></i> محافظ إلكترونية</span> break;
                                            default: <span>@p.PaymentMethod</span> break;
                                        }
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(p.ReferenceNumber))
                                {
                                    <tr>
                                        <th class="text-muted">رقم السند</th>
                                        <td><code>@p.ReferenceNumber</code></td>
                                    </tr>
                                }
                                <tr>
                                    <th class="text-muted">التاريخ</th>
                                    <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">الموظف</th>
                                    <td>@p.RecordedBy</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(p.Notes))
                                {
                                    <tr>
                                        <th class="text-muted">ملاحظة</th>
                                        <td class="small">@p.Notes</td>
                                    </tr>
                                }
                            </table>
                            @if (!p.IsCancelled)
                            {
                                <div class="mt-2 pt-2 border-top">
                                    <form asp-controller="Payments" asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الدفعة؟ سيتم تحديث رصيد الفاتورة.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.PaymentId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> حذف الدفعة</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
                else { <p class="text-muted text-center py-3">لا توجد دفعات</p> }
            </div>
        </div>
    </div>
</div>
<a asp-action="Index" class="btn btn-outline-secondary mt-3"><i class="bi bi-arrow-right"></i> العودة</a>
