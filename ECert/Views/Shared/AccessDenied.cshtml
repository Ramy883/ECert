@{
    ViewData["Title"] = "غير مصرح";
    var roleName = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string dashController = roleName switch
    {
        "SuperAdmin" => "Dashboard",
        "Admin" => "ManagerDashboard",
        "Media" => "MediaDashboard",
        "Finance" => "FinanceDashboard",
        _ => "Dashboard"
    };
    Layout = User.Identity?.IsAuthenticated == true ? "_AdminLayout" : "_Layout";
}
<div class="text-center py-5">
    <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
    <h2 class="mt-3">غير مصرح بالوصول</h2>
    <p class="text-muted fs-5">ليس لديك صلاحية للوصول إلى هذه الصفحة.</p>
    <a asp-controller="@dashController" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-house"></i> العودة إلى لوحة التحكم
    </a>
</div>
