@* Unified page header: reads Title, PageIcon, PageDesc from ViewData *@
<div class="d-flex align-items-start gap-3 flex-grow-1">
    @if (!string.IsNullOrEmpty(ViewData["PageIcon"]?.ToString()))
    {
        <div class="page-header-icon">
            <i class="bi @ViewData["PageIcon"]"></i>
        </div>
    }
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        @if (!string.IsNullOrEmpty(ViewData["PageDesc"]?.ToString()))
        {
            <p class="page-desc mb-0">@ViewData["PageDesc"]</p>
        }
    </div>
</div>
