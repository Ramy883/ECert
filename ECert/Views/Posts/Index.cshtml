@model List<Post>
@{
    ViewData["Title"] = "الأخبار";
}

<div class="text-center mb-5">
    <h2 class="fw-bold"><i class="bi bi-newspaper text-primary"></i> آخر الأخبار</h2>
    <p class="text-muted">تابع آخر أخبار المركز والفعاليات والإعلانات</p>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden news-card">
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" alt="@post.Title" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height:200px; background: linear-gradient(135deg, #eff6ff, #dbeafe);">
                            <i class="bi bi-newspaper" style="font-size:3rem; color:#1a56db; opacity:0.4;"></i>
                        </div>
                    }
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary"><i class="bi bi-calendar3"></i> @post.PublishedAt?.ToString("yyyy/MM/dd")</span>
                            @* اسم الناشر يظهر للإدارة فقط — لا نعرضه للزائر العام *@
                        </div>
                        <h6 class="card-title fw-bold mb-2">@post.Title</h6>
                        <p class="card-text small text-muted">@(post.Content.Length > 100 ? post.Content[..100] + "..." : post.Content)</p>
                    </div>
                    <div class="card-footer bg-white border-0 p-3 pt-0">
                        <a asp-action="Details" asp-route-id="@post.PostId" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-book"></i> اقرأ المزيد
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="mb-3"><i class="bi bi-newspaper text-muted" style="font-size: 4rem;"></i></div>
        <h5 class="text-muted">لا توجد أخبار حالياً</h5>
        <p class="text-muted">سيتم نشر الأخبار هنا فور توفرها</p>
    </div>
}
