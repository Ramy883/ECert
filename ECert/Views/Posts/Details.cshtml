@model Post
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <article class="card border-0 shadow-sm rounded-4 overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="card-img-top" style="max-height:400px; object-fit:cover;" alt="@Model.Title" />
            }
            <div class="card-body p-4 p-lg-5">
                <h1 class="fw-bold mb-3">@Model.Title</h1>
                <div class="d-flex align-items-center gap-3 text-muted mb-4">
                    <span><i class="bi bi-calendar3"></i> @Model.PublishedAt?.ToString("yyyy/MM/dd")</span>
                </div>
                <hr />
                <div class="mt-4" style="line-height: 2; font-size: 1.05rem;">@Model.Content</div>
            </div>
        </article>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill mt-3 px-4"><i class="bi bi-arrow-right"></i> العودة للأخبار</a>
    </div>
</div>
