@model Registration
@{
    ViewData["Title"] = "تفاصيل التسجيل";
    Layout = "_AdminLayout";
}
<h2 class="mb-4"><i class="bi bi-clipboard-check"></i> تفاصيل التسجيل #@Model.RequestNumber</h2>
<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0">بيانات المتدرب</h6></div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr><th class="w-50">الاسم بالعربية</th><td>@(Model.FullNameArabic ?? Model.FullName)</td></tr>
                    <tr><th>الاسم بالإنجليزية</th><td dir="ltr">@(Model.FullNameEnglish ?? Model.FullName)</td></tr>
                    <tr><th>الجنس</th><td>@(Model.Gender == "Male" ? "ذكر" : Model.Gender == "Female" ? "أنثى" : "-")</td></tr>
                    <tr><th>الهاتف</th><td>@Model.Phone</td></tr>
                    <tr><th>البريد</th><td>@(Model.Email ?? "-")</td></tr>
                    <tr><th>كيف سمع عنا</th><td>@(Model.HeardFrom ?? "-")</td></tr>
                    <tr><th>الدورة</th><td>@Model.Course?.CourseName</td></tr>
                    <tr><th>المستند</th><td>
                        @if (!string.IsNullOrWhiteSpace(Model.DocumentPath))
                        {
                            <a asp-controller="Registration" asp-action="Document" asp-route-id="@Model.RegistrationId" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-arrow-down"></i> @(Model.DocumentOriginalName ?? "فتح المستند")</a>
                        }
                        else
                        {
                            <span class="text-muted">لا يوجد مستند</span>
                        }
                        <form asp-controller="Registrations" asp-action="UploadDocument" asp-route-id="@Model.RegistrationId" method="post" enctype="multipart/form-data" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="file" name="document" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg,.webp,application/pdf,image/png,image/jpeg,image/webp" required />
                            <button type="submit" class="btn btn-sm btn-outline-secondary mt-2"><i class="bi bi-upload"></i> رفع/استبدال المستند</button>
                        </form>
                    </td></tr>
                    <tr><th>تاريخ التسجيل</th><td>@Model.RegistrationDate.ToString("yyyy-MM-dd HH:mm")</td></tr>
                    <tr><th>الحالة</th><td>
                        @switch (Model.Status)
                        {
                            case "Pending": <span class="badge bg-warning text-dark">معلق</span> break;
                            case "Accepted": <span class="badge bg-success">مقبول</span> break;
                            case "Rejected": <span class="badge bg-danger">مرفوض</span> break;
                        }
                    </td></tr>
                    @if (Model.Status == "Accepted")
                    {
                        <tr><th>تاريخ القبول</th><td>@Model.AcceptedDate?.ToString("yyyy-MM-dd")</td></tr>
                        <tr><th>الموظف</th><td>@Model.ProcessedBy</td></tr>
                    }
                    @if (Model.Status == "Rejected")
                    {
                        <tr><th>سبب الرفض</th><td class="text-danger">@Model.RejectionReason</td></tr>
                        <tr><th>الموظف</th><td>@Model.ProcessedBy</td></tr>
                    }
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white"><h6 class="mb-0">الفاتورة</h6></div>
            <div class="card-body">
                @if (Model.Invoice != null)
                {
                    <p><strong>رقم الفاتورة:</strong> @Model.Invoice.InvoiceNumber</p>
                    <p><strong>المبلغ:</strong> @Model.Invoice.TotalAmount.ToString("N0") ريال</p>
                    <p><strong>المدفوع:</strong> @Model.Invoice.PaidAmount.ToString("N0") ريال</p>
                    <p><strong>المتبقي:</strong> @Model.Invoice.RemainingAmount.ToString("N0") ريال</p>
                    <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.Invoice.InvoiceId" class="btn btn-sm btn-outline-primary">عرض الفاتورة</a>
                }
                else
                {
                    <p class="text-muted">لا توجد فاتورة. عند قبول التسجيل تُنشأ الفاتورة تلقائيًا.</p>
                    @if (Model.Status == "Accepted")
                    {
                        <a asp-controller="Invoices" asp-action="Create" asp-route-registrationId="@Model.RegistrationId" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-repeat"></i> تأكيد/استكمال الفاتورة</a>
                    }
                }
            </div>
        </div>
        @if (Model.Status == "Pending")
        {
            <div class="d-flex gap-2">
                <form asp-action="Accept" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.RegistrationId" />
                    <button type="submit" class="btn btn-success"><i class="bi bi-check"></i> قبول</button>
                </form>
                <a asp-action="Reject" asp-route-id="@Model.RegistrationId" class="btn btn-danger"><i class="bi bi-x"></i> رفض</a>
            </div>
        }
    </div>
</div>
<a asp-action="Index" class="btn btn-outline-secondary mt-3"><i class="bi bi-arrow-right"></i> العودة</a>
