@model RejectRegistrationViewModel
@{
    ViewData["Title"] = "رفض الطلب";
    Layout = "_AdminLayout";
    var returnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Model.ReturnUrl : (Url.Action("Index", "Registrations") ?? "/Registrations");
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-danger-subtle text-danger" style="width:42px;height:42px;"><i class="bi bi-x-circle fs-5"></i></span>
                    <div>
                        <h5 class="mb-0 text-danger">رفض طلب التسجيل</h5>
                        <small class="text-muted">أضف سبباً واضحاً ليظهر في سجل الطلب.</small>
                    </div>
                </div>
                <form asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RegistrationId" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label fw-semibold"></label>
                        <textarea asp-for="Reason" class="form-control" rows="4" maxlength="500" placeholder="مثال: عدم استيفاء متطلبات التسجيل أو وجود بيانات غير مكتملة"></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="@returnUrl" class="btn btn-light">إلغاء</a>
                        <button type="submit" class="btn btn-danger ms-auto" onclick="return confirm('هل أنت متأكد من رفض هذا الطلب؟');">
                            <i class="bi bi-x-lg"></i> تأكيد الرفض
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
