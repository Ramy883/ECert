@model List<ECert.Models.Category>
@{
    ViewData["Title"] = "إدارة الفئات";
    ViewData["PageIcon"] = "bi-grid-3x3-gap";
    ViewData["PageDesc"] = "تصنيف الدورات التدريبية حسب التخصص والمجال";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إضافة فئة</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الفئة..." />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> بحث</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search)) { <a asp-action="Index" class="btn btn-outline-secondary">مسح</a> }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>الأيقونة</th>
                        <th>اسم الفئة</th>
                        <th>الوصف</th>
                        <th>عدد الدورات</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(cat.IconUrl))
                                {
                                    <img src="@cat.IconUrl" alt="@cat.CategoryName" style="width:40px;height:40px;object-fit:contain;border-radius:8px;" />
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-image" style="font-size:1.5rem;"></i></span>
                                }
                            </td>
                            <td class="fw-bold">@cat.CategoryName</td>
                            <td class="text-muted small">@(cat.Description ?? "-")</td>
                            <td><span class="badge bg-info">@cat.Courses.Count</span></td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge bg-success">نشطة</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">معطلة</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@cat.CategoryId" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الفئة؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
