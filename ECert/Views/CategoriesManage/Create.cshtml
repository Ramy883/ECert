@model ECert.Models.Category
@{
    ViewData["Title"] = "إضافة فئة";
    Layout = "_AdminLayout";
}
<h2 class="mb-4"><i class="bi bi-plus-circle"></i> إضافة فئة جديدة</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">اسم الفئة</label>
                <input type="text" name="CategoryName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">الوصف</label>
                <textarea name="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">أيقونة الفئة (صورة)</label>
                <input type="file" name="icon" accept="image/*" class="form-control" onchange="previewIcon(this)" />
                <div class="mt-2 text-center">
                    <img id="iconPreview" src="" alt="" style="display:none; max-width:100px; max-height:100px; object-fit:contain; border-radius:12px; border:2px solid #ddd; padding:5px;" />
                </div>
                <small class="text-muted">اختر صورة أو أيقونة تمثل الفئة (مثلاً: سماعة طبيب لفئة الطب)</small>
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked />
                <label class="form-check-label">نشطة</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> حفظ الفئة</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function previewIcon(input) {
    const preview = document.getElementById('iconPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.src = e.target.result;
            preview.style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
