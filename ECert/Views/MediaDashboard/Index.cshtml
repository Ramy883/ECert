@{
    ViewData["Title"] = "لوحة الإعلامي";
    Layout = "_AdminLayout";
    var recentPosts = ViewBag.RecentPosts as List<ECert.Models.Post> ?? new();
}
<h2 class="mb-4"><i class="bi bi-speedometer2"></i> لوحة تحكم الإعلامي</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <a asp-controller="PostsManage" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body text-center">
                    <h3>@ViewBag.TotalPosts</h3>
                    <small><i class="bi bi-newspaper"></i> المنشورات</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body text-center">
                <h3>@ViewBag.PublishedPosts</h3>
                <small><i class="bi bi-check-circle"></i> منشورات منشورة</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm bg-warning text-dark h-100">
            <div class="card-body text-center">
                <h3>@ViewBag.DraftPosts</h3>
                <small><i class="bi bi-pencil"></i> مسودات</small>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <a asp-controller="NewsManage" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body text-center">
                    <h3>@ViewBag.TotalNews</h3>
                    <small><i class="bi bi-megaphone"></i> الأخبار</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body text-center">
                <h3>@ViewBag.PublishedNews</h3>
                <small><i class="bi bi-broadcast"></i> أخبار منشورة</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="mb-3">إجراءات سريعة</h6>
                <a asp-controller="PostsManage" asp-action="Create" class="btn btn-primary btn-sm me-1"><i class="bi bi-plus-circle"></i> إضافة منشور</a>
                <a asp-controller="NewsManage" asp-action="Create" class="btn btn-info btn-sm me-1 text-white"><i class="bi bi-plus-circle"></i> إضافة خبر</a>
                <a asp-controller="PostsManage" asp-action="Index" class="btn btn-outline-secondary btn-sm me-1"><i class="bi bi-newspaper"></i> إدارة المنشورات</a>
                <a asp-controller="NewsManage" asp-action="Index" class="btn btn-outline-info btn-sm me-1"><i class="bi bi-megaphone"></i> إدارة الأخبار</a>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-clock-history"></i> أحدث المحتوى</h6></div>
    <div class="card-body">
        @if (recentPosts.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>العنوان</th><th>النوع</th><th>الحالة</th><th>التاريخ</th></tr></thead>
                    <tbody>
                        @foreach (var p in recentPosts)
                        {
                            <tr>
                                <td>@p.Title</td>
                                <td>@(p.PostType == "News" ? "خبر" : "منشور")</td>
                                <td>
                                    @switch (p.Status)
                                    {
                                        case "Published":
                                            @:<span class="badge bg-success">منشور</span>
                                            break;
                                        case "Draft":
                                            @:<span class="badge bg-warning text-dark">مسودة</span>
                                            break;
                                        case "Archived":
                                            @:<span class="badge bg-secondary">مؤرشف</span>
                                            break;
                                    }
                                </td>
                                <td>@p.CreatedAt.ToString("MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else { <p class="text-muted text-center">لا يوجد محتوى</p> }
    </div>
</div>
