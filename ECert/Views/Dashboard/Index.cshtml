@model DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم";
    Layout = "_AdminLayout";
}
<h2 class="mb-4"><i class="bi bi-speedometer2"></i> لوحة التحكم</h2>

<!-- Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <a asp-controller="Registrations" asp-action="Index" asp-route-status="Pending" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body text-center">
                    <h3>@Model.PendingRegistrations</h3>
                    <small><i class="bi bi-hourglass-split"></i> تسجيلات معلقة</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <a asp-controller="Invoices" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-danger text-white h-100">
                <div class="card-body text-center">
                    <h3>@Model.UnpaidInvoices</h3>
                    <small><i class="bi bi-receipt"></i> فواتير غير مدفوعة</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <a asp-controller="CoursesManage" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body text-center">
                    <h3>@Model.ActiveCourses</h3>
                    <small><i class="bi bi-book"></i> دورات نشطة</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <a asp-controller="PostsManage" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body text-center">
                    <h3>@Model.NewPosts</h3>
                    <small><i class="bi bi-newspaper"></i> منشورات جديدة</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <a asp-controller="Reports" asp-action="CourseRevenue" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body text-center">
                    <h3>@Model.TotalRevenue.ToString("N0")</h3>
                    <small><i class="bi bi-cash-stack"></i> إجمالي الإيرادات</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-2">
        <a asp-controller="Registrations" asp-action="Index" asp-route-status="Accepted" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-secondary text-white h-100">
                <div class="card-body text-center">
                    <h3>@Model.TotalTrainees</h3>
                    <small><i class="bi bi-people"></i> المتدربين</small>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="mb-3">إجراءات سريعة</h6>
                <a asp-controller="Registrations" asp-action="Index" class="btn btn-outline-primary btn-sm me-1"><i class="bi bi-clipboard-check"></i> التسجيلات</a>
                <a asp-controller="Invoices" asp-action="Index" class="btn btn-outline-success btn-sm me-1"><i class="bi bi-receipt"></i> الفواتير</a>
                <a asp-controller="CoursesManage" asp-action="Index" class="btn btn-outline-info btn-sm me-1"><i class="bi bi-book"></i> الدورات</a>
                <a asp-controller="Certificates" asp-action="Index" class="btn btn-outline-warning btn-sm me-1"><i class="bi bi-award"></i> الشهادات</a>
                <a asp-controller="PostsManage" asp-action="Index" class="btn btn-outline-secondary btn-sm me-1"><i class="bi bi-newspaper"></i> المنشورات</a>
                <a asp-controller="Reports" asp-action="CourseRevenue" class="btn btn-outline-dark btn-sm me-1"><i class="bi bi-graph-up"></i> التقارير</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-clock-history"></i> أحدث التسجيلات</h6></div>
            <div class="card-body">
                @if (Model.RecentRegistrations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead><tr><th>الاسم</th><th>الدورة</th><th>الحالة</th><th>التاريخ</th></tr></thead>
                            <tbody>
                                @foreach (var r in Model.RecentRegistrations)
                                {
                                    <tr>
                                        <td>@r.FullName</td>
                                        <td>@r.Course?.CourseName</td>
                                        <td>
                                            @switch (r.Status)
                                            {
                                                case "Pending": <span class="badge bg-warning text-dark">معلق</span> break;
                                                case "Accepted": <span class="badge bg-success">مقبول</span> break;
                                                case "Rejected": <span class="badge bg-danger">مرفوض</span> break;
                                            }
                                        </td>
                                        <td>@r.RegistrationDate.ToString("MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else { <p class="text-muted text-center">لا توجد تسجيلات</p> }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-receipt"></i> أحدث الفواتير</h6></div>
            <div class="card-body">
                @if (Model.RecentInvoices.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead><tr><th>الرقم</th><th>المتدرب</th><th>المبلغ</th><th>الحالة</th></tr></thead>
                            <tbody>
                                @foreach (var inv in Model.RecentInvoices)
                                {
                                    <tr>
                                        <td><code>@inv.InvoiceNumber</code></td>
                                        <td>@inv.TraineeName</td>
                                        <td>@inv.TotalAmount.ToString("N0") ريال</td>
                                        <td>
                                            @switch (inv.Status)
                                            {
                                                case "Unpaid": <span class="badge bg-danger">غير مدفوعة</span> break;
                                                case "PartiallyPaid": <span class="badge bg-warning text-dark">مدفوعة جزئياً</span> break;
                                                case "Paid": <span class="badge bg-success">مدفوعة</span> break;
                                                case "Cancelled": <span class="badge bg-secondary">ملغية</span> break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else { <p class="text-muted text-center">لا توجد فواتير</p> }
            </div>
        </div>
    </div>
</div>
