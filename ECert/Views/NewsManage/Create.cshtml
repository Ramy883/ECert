@model ECert.Models.Post
@{
    ViewData["Title"] = "إضافة خبر";
    Layout = "_AdminLayout";
}
<h2 class="mb-4"><i class="bi bi-plus-circle"></i> إضافة خبر جديد</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Title" class="form-label">العنوان</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Content" class="form-label">المحتوى</label>
                <textarea asp-for="Content" class="form-control" rows="8" required></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">الصورة الرئيسية</label>
                <input type="file" name="image" accept="image/*" class="form-control" onchange="previewPhoto(this)" />
                <div class="mt-2 text-center">
                    <img id="photoPreview" src="" alt="" style="display:none; max-width:300px; max-height:200px; object-fit:cover; border-radius:8px; border:2px solid #ddd;" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label">الحالة</label>
                <select asp-for="Status" class="form-select">
                    <option value="Draft">مسودة</option>
                    <option value="Published">نشر مباشرة</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> حفظ الخبر</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
