@{
    ViewData["Title"] = "سجل العمليات";
    ViewData["PageIcon"] = "bi-journal-text";
    ViewData["PageDesc"] = "تتبع جميع العمليات التي تمت في النظام مع المستخدم والتوقيت";
    Layout = "_AdminLayout";
    var logs = ViewBag.Logs as List<AuditLog> ?? new();
    var entityType = ViewBag.EntityType as string;
    var action = ViewBag.Action as string;
}
<div class="page-header">
    <partial name="_PageHeader" />
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">نوع العنصر</label>
                <select name="entityType" class="form-select">
                    <option value="">الكل</option>
                    <option value="Registration" selected="@(entityType == "Registration")">تسجيل</option>
                    <option value="Invoice" selected="@(entityType == "Invoice")">فاتورة</option>
                    <option value="Payment" selected="@(entityType == "Payment")">دفعة</option>
                    <option value="Certificate" selected="@(entityType == "Certificate")">شهادة</option>
                    <option value="Course" selected="@(entityType == "Course")">دورة</option>
                    <option value="User" selected="@(entityType == "User")">مستخدم</option>
                    <option value="Post" selected="@(entityType == "Post")">منشور</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">العملية</label>
                <select name="action" class="form-select">
                    <option value="">الكل</option>
                    <option value="Create" selected="@(action == "Create")">إنشاء</option>
                    <option value="Update" selected="@(action == "Update")">تعديل</option>
                    <option value="Delete" selected="@(action == "Delete")">حذف</option>
                    <option value="Accept" selected="@(action == "Accept")">قبول</option>
                    <option value="Reject" selected="@(action == "Reject")">رفض</option>
                    <option value="Issue" selected="@(action == "Issue")">إصدار</option>
                    <option value="Cancel" selected="@(action == "Cancel")">إلغاء</option>
                    <option value="Login" selected="@(action == "Login")">تسجيل دخول</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> تصفية</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>المستخدم</th>
                        <th>العملية</th>
                        <th>نوع العنصر</th>
                        <th>رقم العنصر</th>
                        <th>التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (logs.Any())
                    {
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td class="small">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><strong>@log.UserName</strong></td>
                                <td>
                                    @switch (log.Action)
                                    {
                                        case "Create": <span class="badge bg-success">إنشاء</span> break;
                                        case "Update": <span class="badge bg-primary">تعديل</span> break;
                                        case "Delete": <span class="badge bg-danger">حذف</span> break;
                                        case "Accept": <span class="badge bg-info">قبول</span> break;
                                        case "Reject": <span class="badge bg-warning text-dark">رفض</span> break;
                                        case "Issue": <span class="badge bg-dark">إصدار</span> break;
                                        case "Cancel": <span class="badge bg-secondary">إلغاء</span> break;
                                        case "Login": <span class="badge bg-light text-dark">دخول</span> break;
                                        default: <span class="badge bg-light text-dark">@log.Action</span> break;
                                    }
                                </td>
                                <td>
                                    @switch (log.EntityType)
                                    {
                                        case "Registration": <span>تسجيل</span> break;
                                        case "Invoice": <span>فاتورة</span> break;
                                        case "Payment": <span>دفعة</span> break;
                                        case "Certificate": <span>شهادة</span> break;
                                        case "Course": <span>دورة</span> break;
                                        case "User": <span>مستخدم</span> break;
                                        case "Post": <span>منشور</span> break;
                                        default: <span>@log.EntityType</span> break;
                                    }
                                </td>
                                <td>@(log.EntityId?.ToString() ?? "-")</td>
                                <td class="small text-muted">@(log.NewValues ?? log.OldValues ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">لا توجد سجلات</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
