@{
    ViewData["Title"] = "إدارة الصفحة الرئيسية";
    ViewData["PageIcon"] = "bi-house-gear";
    ViewData["PageDesc"] = "التحكم الكامل في محتوى وتصميم الصفحة الرئيسية للموقع";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a href="/" target="_blank" class="btn btn-outline-primary"><i class="bi bi-eye me-1"></i>معاينة الموقع</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <a href="/HomepageManage/Slides" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-images display-4 text-primary"></i>
                <h6 class="mt-3">الشرائح (Slider)</h6>
                <small class="text-muted">إدارة شرائح القسم الرئيسي</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/AnimatedTexts" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-type display-4 text-success"></i>
                <h6 class="mt-3">النصوص المتحركة</h6>
                <small class="text-muted">نصوص متغيرة في القسم الرئيسي</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/Sections" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-layout-three-columns display-4 text-warning"></i>
                <h6 class="mt-3">إدارة الأقسام</h6>
                <small class="text-muted">إظهار/إخفاء وترتيب الأقسام</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/Stats" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-bar-chart display-4 text-info"></i>
                <h6 class="mt-3">الإحصائيات</h6>
                <small class="text-muted">بطاقات الأرقام والإحصائيات</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/Contact" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-telephone display-4 text-danger"></i>
                <h6 class="mt-3">معلومات التواصل</h6>
                <small class="text-muted">الهاتف، البريد، العنوان</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/Social" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-share display-4 text-purple" style="color:#7c3aed"></i>
                <h6 class="mt-3">التواصل الاجتماعي</h6>
                <small class="text-muted">روابط المنصات الاجتماعية</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/AboutFooter" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-layout-text-sidebar-reverse display-4" style="color:#0f766e"></i>
                <h6 class="mt-3">من نحن والفوتر</h6>
                <small class="text-muted">نبذة المركز والتحكم في ظهور الفوتر</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/Theme" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-palette display-4 text-secondary"></i>
                <h6 class="mt-3">الألوان والهوية</h6>
                <small class="text-muted">تخصيص ألوان الموقع</small>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/HomepageManage/SiteSettings" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-gear display-4 text-dark"></i>
                <h6 class="mt-3">إعدادات الموقع</h6>
                <small class="text-muted">الاسم، الشعار، SEO</small>
            </div>
        </a>
    </div>
</div>
