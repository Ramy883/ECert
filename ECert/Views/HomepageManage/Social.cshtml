@model List<ECert.Models.SocialLink>
@{
    ViewData["Title"] = "روابط التواصل الاجتماعي";
    ViewData["PageIcon"] = "bi-share";
    ViewData["PageDesc"] = "إدارة حسابات المركز على منصات التواصل الاجتماعي";
    Layout = "_AdminLayout";
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-right me-1"></i>الرجوع إلى إدارة الصفحة الرئيسية</a>

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<div class="alert alert-info d-flex align-items-start gap-2">
    <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
    <div>
        <strong>طريقة الظهور للعامة:</strong> الرابط يظهر للزوار في تذييل الموقع فقط عندما تكون <strong>الحالة مفعّلة</strong> (محددة) <strong>وبرابط حقيقي</strong> يبدأ بـ <code>https://</code> — الروابط التي قيمتها <code>#</code> أو فارغة لا تظهر أبداً.
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <form method="post" action="/HomepageManage/SaveSocial">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>المنصة</th><th>الأيقونة</th><th>الرابط</th><th>الحالة</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var l = Model[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="links[@i].SocialLinkId" value="@l.SocialLinkId" />
                                        <input type="text" name="links[@i].PlatformName" value="@l.PlatformName" class="form-control form-control-sm" style="width:120px" />
                                    </td>
                                    <td>
                                        <input type="text" name="links[@i].IconClass" value="@l.IconClass" class="form-control form-control-sm" style="width:130px" />
                                        <i class="bi @l.IconClass ms-1"></i>
                                    </td>
                                    <td>
                                        <input type="text" name="links[@i].Url" value="@l.Url" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input type="hidden" name="links[@i].IsActive" value="false" />
                                        <input type="checkbox" name="links[@i].IsActive" value="true" class="form-check-input" @(l.IsActive ? "checked" : "") />
                                    </td>
                                    <td>
                                        <form method="post" action="/HomepageManage/DeleteSocial" class="d-inline" onsubmit="return confirm('حذف؟')">
                                            <input type="hidden" name="id" value="@l.SocialLinkId" />
                                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary"><i class="bi bi-check me-1"></i>حفظ الروابط</button>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><strong>إضافة منصة</strong></div>
            <div class="card-body">
                <form method="post" action="/HomepageManage/AddSocial">
                    <div class="mb-3">
                        <label class="form-label">اسم المنصة</label>
                        <input type="text" name="platformName" class="form-control" placeholder="WhatsApp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الأيقونة (Bootstrap Icon)</label>
                        <input type="text" name="iconClass" class="form-control" placeholder="bi-whatsapp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الرابط</label>
                        <input type="text" name="url" class="form-control" placeholder="https://..." />
                    </div>
                    <button class="btn btn-success w-100"><i class="bi bi-plus me-1"></i>إضافة</button>
                </form>
            </div>
        </div>
    </div>
</div>
